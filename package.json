{
  "name": "cade",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote",
    "test": "node --test",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "slack:create": "node scripts/slack-app.mjs create",
    "slack:update": "node scripts/slack-app.mjs update",
    "config": "node scripts/config.mjs",
    "sheet:create": "node scripts/sheet-app.mjs create",
    "sheet:update": "node scripts/sheet-app.mjs update",
    "doc:create": "node scripts/doc-app.mjs create",
    "doc:update": "node scripts/doc-app.mjs update"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "wrangler": "^4.152.0"
  }
}
